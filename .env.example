# CryoKrypton Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.

# Alibaba Cloud Model Studio (Qwen3.7-Plus / Multimodal VL Models) API Key
# Get one from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-sk-dashscope-api-key-here

# MQTT Broker Configuration for Live Dual-Laptop Emulation
# Public broker fallback: broker.emqx.io (port 1883)
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=device/telemetry/chunks
